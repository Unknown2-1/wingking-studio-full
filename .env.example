# Copy into legacy-nextjs/.env for local legacy Next.js development only.
# Never paste production database passwords, API secrets or admin credentials into GitHub.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB"
ADMIN_PASSWORD_SCRYPT="GENERATE_LOCALLY"
ADMIN_SESSION_SECRET="GENERATE_RANDOM_32+_CHARS"
# Supabase Edge functions read secret values only from Supabase environment configuration:
# SUPABASE_URL=<your project URL>
# SUPABASE_ANON_KEY=<public anon key>
# SUPABASE_SERVICE_ROLE_KEY=<secret set in cloud, NEVER commit>
